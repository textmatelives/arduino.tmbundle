<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>autoScrollOutput</key>
	<true/>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby -Eutf-8
$VERBOSE = nil # Bundle Support is noisy under macOS Ruby 2.6; these scripts need no warnings.
require ENV["TM_SUPPORT_PATH"] + "/lib/tm/executor"

def save_temp_sketch(contents)
  require "tmpdir"
  require "fileutils"
  dir = Dir.mktmpdir
  at_exit { FileUtils.remove_entry dir }
  sketch = File.join(dir, "Sketch")
  FileUtils.mkdir_p sketch
  File.write(File.join(sketch, "Sketch.ino"), contents)
  sketch
end

sketch = ENV["TM_FILEPATH"] ? File.dirname(ENV["TM_FILEPATH"]) : save_temp_sketch(STDIN.read)

TextMate::Executor.run("#{ENV['TM_BUNDLE_SUPPORT']}/bin/arduino-build",
  :script_args =&gt; ["upload", sketch], :verb =&gt; "Compiling &amp; uploading",
  :use_hashbang =&gt; false)
</string>
	<key>input</key>
	<string>document</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>@u</string>
	<key>name</key>
	<string>Upload to Board</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.c++.arduino</string>
	<key>uuid</key>
	<string>66F3D8A7-5A16-4D87-9962-3A25328DC71A</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
