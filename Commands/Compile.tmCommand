<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>autoScrollOutput</key>
	<true/>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby -Eutf-8
$VERBOSE = nil # Bundle Support is noisy under macOS Ruby 2.6; these scripts need no warnings.
require ENV["TM_SUPPORT_PATH"] + "/lib/tm/executor"

abort "Save the sketch first -- arduino-cli needs the sketch folder" unless ENV["TM_FILEPATH"]
sketch = File.dirname(ENV["TM_FILEPATH"])

TextMate::Executor.run("#{ENV['TM_BUNDLE_SUPPORT']}/bin/arduino-build",
  :script_args =&gt; ["compile", sketch], :verb =&gt; "Compiling",
  :use_hashbang =&gt; false)
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>@b</string>
	<key>name</key>
	<string>Verify Sketch (compile)</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.c++.arduino</string>
	<key>uuid</key>
	<string>B901B2C1-83A7-48E6-BA88-00220566836C</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
