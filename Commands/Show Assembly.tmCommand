<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>saveModifiedFiles</string>
	<key>command</key>
	<string>#!/bin/bash
[ -n "$TM_FILEPATH" ] || { echo "Save the sketch first"; exit 1; }
"$TM_BUNDLE_SUPPORT/bin/arduino-build" asm "${TM_FILEPATH%/*}"
</string>
	<key>input</key>
	<string>none</string>
	<key>keyEquivalent</key>
	<string>@B</string>
	<key>name</key>
	<string>Show Assembly</string>
	<key>output</key>
	<string>openAsNewDocument</string>
	<key>scope</key>
	<string>source.c++.arduino</string>
	<key>uuid</key>
	<string>6CD0AE16-8CB5-4019-82D6-39C45933A5E9</string>
</dict>
</plist>
