<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>autoScrollOutput</key>
	<true/>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby -Eutf-8
$VERBOSE = nil # Bundle Support is noisy under macOS Ruby 2.6; these scripts need no warnings.
# Clean wipes arduino-cli's build cache, forcing a full rebuild next compile.
require ENV["TM_SUPPORT_PATH"] + "/lib/tm/executor"

TextMate::Executor.run("#{ENV['TM_BUNDLE_SUPPORT']}/bin/arduino-build",
  :script_args =&gt; ["clean"],
  :use_hashbang =&gt; false)
</string>
	<key>input</key>
	<string>none</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^@c</string>
	<key>name</key>
	<string>Clean (empty the build cache)</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.c++.arduino</string>
	<key>uuid</key>
	<string>A39EFEA0-67CB-4666-BD90-3A735CBB42A2</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
