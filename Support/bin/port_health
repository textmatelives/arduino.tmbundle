#!/usr/bin/env python3
"""Sample a serial port before the monitor starts.

classify reads raw bytes on stdin and prints one word: ok, wedged, or garbage.
probe opens a port for a quarter of a second, without touching DTR or RTS, and
prints shell assignments (verdict, bytes, seconds, rate, limit).

A wedged CP2102 sends a 00 80 stream faster than the baud rate can carry.
The monitor would print that as ????. Garbage that is slow enough to be a
real serial stream is a baud mismatch, not a wedged adapter.
"""
import argparse
import os
import select
import sys
import termios
import time

def printable(b):
    return b in (9, 10, 13) or 32 <= b <= 126

def classify(data, seconds, baud):
    n = len(data)
    if n < 24 or seconds <= 0 or baud <= 0:
        return "ok"
    ctrl = sum(1 for b in data if b in (0x00, 0x80))
    rate = n / seconds
    # 8N1 carries at most baud/10 bytes per second. Faster than that, and
    # almost all 00 or 80, is the adapter status flood, not the sketch.
    if ctrl / n >= 0.90 and rate > baud / 10.0:
        return "wedged"
    text = sum(1 for b in data if printable(b))
    if text / n < 0.50:
        return "garbage"
    return "ok"

def probe(port, baud, seconds):
    try:
        fd = os.open(port, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError as e:
        return {"verdict": "skip", "bytes": 0, "seconds": 0, "rate": 0,
                "limit": baud // 10, "note": e.strerror}
    try:
        attrs = termios.tcgetattr(fd)
        attrs[0] = 0
        attrs[1] = 0
        attrs[2] = (attrs[2] & ~termios.CSIZE) | termios.CS8 | termios.CREAD | termios.CLOCAL
        attrs[3] = 0
        attrs[4] = baud
        attrs[5] = baud
        attrs[6][termios.VMIN] = 0
        attrs[6][termios.VTIME] = 0
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        termios.tcflush(fd, termios.TCIFLUSH)
        end = time.time() + seconds
        buf = b""
        while time.time() < end:
            got, _, _ = select.select([fd], [], [], 0.05)
            if not got:
                continue
            try:
                chunk = os.read(fd, 8192)
            except BlockingIOError:
                chunk = b""
            if chunk:
                buf += chunk
    except OSError as e:
        return {"verdict": "skip", "bytes": 0, "seconds": 0, "rate": 0,
                "limit": baud // 10, "note": e.strerror}
    finally:
        os.close(fd)
    verdict = classify(buf, seconds, baud)
    n = len(buf)
    return {"verdict": verdict, "bytes": n, "seconds": seconds,
            "rate": int(n / seconds) if seconds else 0, "limit": baud // 10, "note": ""}

def emit(fields):
    for key in ("verdict", "bytes", "seconds", "rate", "limit"):
        print("%s=%s" % (key, fields[key]))
    if fields.get("note"):
        print("note=%s" % fields["note"])

def main(argv):
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("classify")
    c.add_argument("--baud", type=int, required=True)
    c.add_argument("--seconds", type=float, required=True)
    r = sub.add_parser("probe")
    r.add_argument("--port", required=True)
    r.add_argument("--baud", type=int, required=True)
    r.add_argument("--seconds", type=float, default=0.25)
    args = p.parse_args(argv)
    if args.cmd == "classify":
        print(classify(sys.stdin.buffer.read(), args.seconds, args.baud))
        return 0
    emit(probe(args.port, args.baud, args.seconds))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
